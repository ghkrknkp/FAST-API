global:
  resolve_timeout: 1m
  smtp_smarthost: 'smtp.gmail.com:587'
  smtp_from: 'alerts@example.com'
  smtp_auth_username: 'alerts@example.com'
  smtp_auth_password: 'YOUR_APP_SPECIFIC_PASSWORD'
  smtp_require_tls: true

# Alert routing tree
route:
  group_by: ['alertname', 'severity']
  group_wait: 5s
  group_interval: 10s
  repeat_interval: 1h
  receiver: 'default-notifications'
  routes:
    - match:
        severity: critical
      receiver: 'critical-alerts'
      repeat_interval: 15m

# Notification receivers
receivers:
  - name: 'default-notifications'
    email_configs:
      - to: 'admin@example.com'
        send_resolved: true
        headers:
          subject: '[API ALERT - {{ .Status | toUpper }}] {{ .CommonLabels.alertname }}'

  - name: 'critical-alerts'
    email_configs:
      - to: 'sre-team@example.com'
        send_resolved: true
        headers:
          subject: '[CRITICAL ALERT - {{ .Status | toUpper }}] {{ .CommonLabels.alertname }}'
    slack_configs:
      - api_url: 'https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK'
        channel: '#api-alerts'
        send_resolved: true
        title: '[{{ .Status | toUpper }}] {{ .CommonLabels.alertname }} ({{ .CommonLabels.severity }})'
        text: >-
          *Summary:* {{ .CommonAnnotations.summary }}
          *Description:* {{ .CommonAnnotations.description }}
          *Remediation:* {{ .CommonAnnotations.remediation }}
