# ==========================================
# FastAPI API Monitoring Stack Configuration
# ==========================================

# Application Settings
APP_NAME=api-monitoring-dashboard
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Authentication
# Secret API key required for GET /protected
API_KEY=secret-token-demo-key-12345

# Health Check Override
# Set to true to simulate an unhealthy service at GET /health
SIMULATE_UNHEALTHY=false

# Alertmanager Email Notification Settings (Optional)
# If unconfigured, Alertmanager logs alerts without external sending
ALERT_EMAIL_TO=admin@example.com
ALERT_EMAIL_FROM=alerts@example.com
ALERT_EMAIL_SMARTHOST=smtp.gmail.com:587
ALERT_EMAIL_AUTH_USERNAME=alerts@example.com
ALERT_EMAIL_AUTH_PASSWORD=your-app-password-here

# Alertmanager Slack Integration Settings (Optional)
ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
ALERT_SLACK_CHANNEL=#api-alerts
