{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "SECTION A: SERVICE OVERVIEW",
      "type": "row"
    },
    {
      "id": 1,
      "title": "API Target Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "up{job=\"fastapi\"}",
          "legendFormat": "Target",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto" }
    },
    {
      "id": 2,
      "title": "Application Health Probe",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "fastapi_app_health_status",
          "legendFormat": "Health",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "UNHEALTHY", "color": "red" }, "1": { "text": "HEALTHY", "color": "green" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto" }
    },
    {
      "id": 3,
      "title": "Uptime (Last 30m)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "avg_over_time(up{job=\"fastapi\"}[30m]) * 100",
          "legendFormat": "Uptime",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 4,
      "title": "Total Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(fastapi_requests_total) or vector(0)",
          "legendFormat": "Total Requests",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "white" }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 5,
      "title": "Successful (2xx)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(fastapi_requests_total{status_code=~\"2..\"}) or vector(0)",
          "legendFormat": "2xx",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 6,
      "title": "Failed (4xx & 5xx)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(fastapi_requests_total{status_code=~\"[45]..\"}) or vector(0)",
          "legendFormat": "Failures",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 7,
      "title": "Error Percentage",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "(sum(rate(fastapi_requests_total{status_code=~\"[45]..\"}[5m])) / (sum(rate(fastapi_requests_total[5m])) > 0)) * 100 or vector(0)",
          "legendFormat": "Error Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 8,
      "title": "Avg Response Time",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "(sum(rate(fastapi_request_duration_seconds_sum[5m])) / (sum(rate(fastapi_request_duration_seconds_count[5m])) > 0)) or vector(0)",
          "legendFormat": "Avg Latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 3.0 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "SECTION B: API PERFORMANCE",
      "type": "row"
    },
    {
      "id": 9,
      "title": "Request Rate (RPS) by Endpoint",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(fastapi_requests_total[1m])) by (endpoint)",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 10,
      "title": "Response Duration (Avg & p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(fastapi_request_duration_seconds_sum[1m])) / sum(rate(fastapi_request_duration_seconds_count[1m]))",
          "legendFormat": "Average Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(fastapi_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Latency",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "thresholdsStyle": { "mode": "line" }
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 3.0 }
            ]
          }
        }
      }
    },
    {
      "id": 11,
      "title": "Slow Requests (> 3.0s SLA Breach) & Active Requests",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(increase(fastapi_slow_requests_total[1m]))",
          "legendFormat": "Requests > 3s (Rate/min)",
          "refId": "A"
        },
        {
          "expr": "fastapi_active_requests",
          "legendFormat": "Active In-Flight Requests",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20
          },
          "unit": "short"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "SECTION C: HTTP STATUS CODES & BREAKDOWN",
      "type": "row"
    },
    {
      "id": 12,
      "title": "Traffic Breakdown by Status Code Class",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(fastapi_requests_total{status_code=~\"2..\"}[1m])) or vector(0)",
          "legendFormat": "2xx Success",
          "refId": "A"
        },
        {
          "expr": "sum(rate(fastapi_requests_total{status_code=~\"4..\"}[1m])) or vector(0)",
          "legendFormat": "4xx Client Errors",
          "refId": "B"
        },
        {
          "expr": "sum(rate(fastapi_requests_total{status_code=~\"5..\"}[1m])) or vector(0)",
          "legendFormat": "5xx Server Errors",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "stacking": { "group": "A", "mode": "normal" },
            "fillOpacity": 30
          },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 13,
      "title": "Authentication Failures (401) & Rate Limiting (429)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(fastapi_auth_failures_total[1m])) or vector(0)",
          "legendFormat": "401 Auth Failures (req/s)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(fastapi_rate_limit_exceeded_total[1m])) or vector(0)",
          "legendFormat": "429 Rate Limits (req/s)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25
          },
          "unit": "reqps"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "title": "SECTION D: ERROR TRENDS & SPIKE ANALYSIS",
      "type": "row"
    },
    {
      "id": 14,
      "title": "HTTP 5xx Server Error Spikes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(fastapi_requests_total{status_code=\"500\"}[1m])) by (endpoint)",
          "legendFormat": "500 - {{endpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 80 },
          "color": { "mode": "fixed", "fixedColor": "red" },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 15,
      "title": "Error Ratio Trend (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "(sum(rate(fastapi_requests_total{status_code=~\"[45]..\"}[1m])) / (sum(rate(fastapi_requests_total[1m])) > 0)) * 100",
          "legendFormat": "Error Ratio %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20 },
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 5.0 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 104,
      "title": "SECTION E: ENDPOINT-LEVEL ANALYSIS",
      "type": "row"
    },
    {
      "id": 16,
      "title": "Endpoint Metrics Summary",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(fastapi_requests_total) by (endpoint)",
          "format": "table",
          "instant": true,
          "legendFormat": "Total Requests",
          "refId": "A"
        },
        {
          "expr": "sum(fastapi_requests_total{status_code=~\"[45]..\"}) by (endpoint)",
          "format": "table",
          "instant": true,
          "legendFormat": "Failures",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "displayMode": "auto" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
      "id": 105,
      "title": "SECTION F: SYSTEM & PROCESS METRICS",
      "type": "row"
    },
    {
      "id": 17,
      "title": "CPU Utilization (%)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "fastapi_process_cpu_percent",
          "legendFormat": "FastAPI Process CPU",
          "refId": "A"
        },
        {
          "expr": "fastapi_system_cpu_percent",
          "legendFormat": "Host System CPU",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "unit": "percent",
          "max": 100
        }
      }
    },
    {
      "id": 18,
      "title": "Memory Consumption",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "fastapi_process_memory_bytes",
          "legendFormat": "Process RSS Memory",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20 },
          "unit": "bytes"
        }
      }
    },
    {
      "id": 19,
      "title": "System Memory (%)",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "fastapi_system_memory_percent",
          "legendFormat": "System Memory Used",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 49 },
      "id": 106,
      "title": "SECTION G: PROMETHEUS ALERT STATUS",
      "type": "row"
    },
    {
      "id": 20,
      "title": "Prometheus Active Alerts",
      "type": "alertlist",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 50 },
      "options": {
        "alertInstanceLabelFilter": "",
        "alertName": "",
        "dashboardAlerts": false,
        "groupBy": [],
        "maxItems": 20,
        "show": "all",
        "sortOrder": 1,
        "stateFilter": {
          "error": true,
          "firing": true,
          "noData": false,
          "normal": true,
          "pending": true
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["fastapi", "prometheus", "observability", "monitoring"],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "API Monitoring Dashboard",
  "description": "FastAPI Application Monitoring — Health, Performance, Errors, and Alerts",
  "uid": "fastapi-monitoring-dashboard",
  "version": 1
}
